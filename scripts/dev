#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_ROOT="$(cd -- "$SCRIPT_DIR/.." && pwd)"

cd "$PROJECT_ROOT"

if [[ "$#" -eq 0 ]]; then
    set -- ci
fi

uv venv --allow-existing --python 3.11
uv pip install --python .venv -r requirements-dev.txt
exec .venv/bin/invoke "$@"
