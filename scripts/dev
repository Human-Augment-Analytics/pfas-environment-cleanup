#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_ROOT="$(cd -- "$SCRIPT_DIR/.." && pwd)"
ENV_DIR="$PROJECT_ROOT/.env-pfas-ci"

cd "$PROJECT_ROOT"

if [[ ! -x "$ENV_DIR/bin/invoke" ]] || ! "$ENV_DIR/bin/python" -c \
    'import sys; raise SystemExit(sys.version_info[:3] != (3, 12, 5))'; then
    echo "[dev] Creating $ENV_DIR"
    uv venv --clear --python 3.12.5 "$ENV_DIR"
    uv pip install --python "$ENV_DIR/bin/python" -r requirements-dev.txt
fi

if [[ "$#" -eq 0 ]]; then
    set -- ci
fi

exec "$ENV_DIR/bin/invoke" "$@"
